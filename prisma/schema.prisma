generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Urgency {
  HIGH
  MEDIUM
  LOW
}

enum Role {
  OWNER
  MANAGER
  DIRECTOR
  C_LEVEL
  EMPLOYEE
  OTHER
  PRIVATE_HOMEOWNER
  PRIVATE_TENANT
  FAMILY_DECISION_MAKER
}

enum LeadStatus {
  PENDING_OTP
  PENDING_VERIFICATION
  NURTURING
  ACTIVE
  QUALIFIED
  DA_VERIFICARE_MANUALMENTE
  ANOMALO
  REJECTED
}

enum AIProvider {
  OPENAI
  ANTHROPIC
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

model OtpToken {
  id        String   @id @default(cuid())
  token     String
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Tenant {
  id                     String     @id @default(uuid())
  companyName            String
  adminEmail             String?    @unique
  apiKey                 String     @unique
  createdAt              DateTime   @default(now())

  credits                Int        @default(10)
  autoUnlockLeads        Boolean    @default(true)
  qualificationThreshold Int        @default(50)

  metaPixelId            String?
  metaCapiToken          String?
  googleConversionUrl    String?

  crmWebhookUrl          String?
  crmWebhookSecret       String?

  aiEnabled              Boolean    @default(true)
  aiProvider             AIProvider @default(OPENAI)
  aiApiKey               String?
  aiModel                String     @default("gpt-4o-mini")
  aiMaxAutonomousSteps   Int        @default(7)
  aiDefaultDelayDays     Int        @default(2)

  aiAgentConfig          AIAgentConfig?
  sequences              Sequence[]
  profiles               Profile[]
  campaigns              Campaign[]
  automationLogs         AutomationLog[]
  trackingEvents         TrackingEvent[]
  aiMessages             AIConversationMessage[]

  @@index([apiKey])
}

model AIAgentConfig {
  id                    String   @id @default(uuid())
  tenantId              String   @unique
  agentName             String   @default("Team Commerciale")
  industryContext       String   @db.Text
  offerCatalog          String   @db.Text
  qualificationCriteria String   @db.Text
  disqualifyingRules    String   @db.Text
  systemPromptOverride  String?  @db.Text
  calendarBookingUrl    String?
  whatsappContact       String?
  temperature           Float    @default(0.4)
  updatedAt             DateTime @updatedAt

  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Profile {
  id                 String     @id @default(uuid())
  tenantId           String
  email              String
  firstName          String?
  lastName           String?
  phone              String?
  vatNumber          String?
  leadType           String     @default("B2B")

  isUnlocked         Boolean    @default(false)
  unlockedAt         DateTime?

  dealStatus         String?
  dealValue          Float?

  sequenceStates     LeadSequenceState[]
  isVerified         Boolean    @default(false)
  status             LeadStatus @default(PENDING_OTP)

  problemDescription String?    @db.Text
  urgency            Urgency?
  role               Role?
  budget             Float?
  icpScore           Int        @default(0)

  industry           String?
  coherenceScore     Int        @default(0)
  source             String?
  lastIp             String?
  fingerprint        String?

  passiveScore       Int        @default(0)
  lastDecayedAt      DateTime?

  recency            Int        @default(0)
  frequency          Int        @default(0)
  monetary           Int        @default(0)
  segment            String     @default("Freddo")

  arch_angle         String?
  is_proxy           Boolean    @default(false)
  contactCount       Int        @default(0)
  totalClicks        Int        @default(0)
  totalRevenue       Float      @default(0)
  lastActivityAt     DateTime?
  lastContactedAt    DateTime?

  aiSummary          String?    @db.Text
  financialClean     Boolean?
  employmentType     String?

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  otpTokens          OtpToken[]
  automationLogs     AutomationLog[]
  trackingEvents     TrackingEvent[]
  webActivities      WebActivity[]
  aiMessages         AIConversationMessage[]

  utmSource          String?
  utmCampaign        String?
  utmMedium          String?

  @@unique([tenantId, email])
}

model AIConversationMessage {
  id          String      @id @default(uuid())
  tenantId    String
  profileId   String
  role        MessageRole
  subject     String?
  content     String      @db.Text
  messageId   String?     @unique
  inReplyTo   String?
  sentiment   String?
  extracted   Json?
  createdAt   DateTime    @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([tenantId])
}

model Sequence {
  id          String              @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean             @default(true)
  useAiEngine Boolean             @default(true)
  maxSteps    Int                 @default(7)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emails      EmailTemplate[]
  enrollments LeadSequenceState[]
}

model EmailTemplate {
  id          String   @id @default(cuid())
  sequenceId  String
  stepNumber  Int
  delayDays   Int
  subject     String
  plainText   String   @db.Text
  aiObjective String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sequence    Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
}

model LeadSequenceState {
  id             String    @id @default(cuid())
  profileId      String
  sequenceId     String
  currentStep    Int       @default(0)
  enrolledAt     DateTime  @default(now())
  lastEmailedAt  DateTime?
  nextActionAt   DateTime?
  isCompleted    Boolean   @default(false)
  isUnsubscribed Boolean   @default(false)

  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sequence       Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([profileId, sequenceId])
}

model Campaign {
  id               String   @id @default(uuid())
  tenantId         String
  name             String
  dailyLimit       Int      @default(20)
  status           String   @default("DRAFT")
  winningVariantId String?
  createdAt        DateTime @default(now())

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AutomationLog {
  id           String   @id @default(uuid())
  tenantId     String
  resendId     String?  @unique
  profileId    String
  campaignId   String?
  variantId    String?
  messageId    String?  @unique
  emailAddress String
  subject      String
  status       String
  spamScore    Float?
  bounceHard   Boolean  @default(false)
  errorMessage String?
  timestamp    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([profileId])
  @@index([campaignId, variantId])
}

model GmailSender {
  id              String    @id @default(uuid())
  tenantId        String?
  email           String    @unique
  appPassword     String
  provider        String    @default("GMAIL")
  smtpHost        String?
  smtpPort        Int?      @default(465)
  imapHost        String?
  imapPort        Int?      @default(993)
  isActive        Boolean   @default(true)
  dailyLimit      Int       @default(10)
  sentToday       Int       @default(0)
  lastSentAt      DateTime?
  quarantineUntil DateTime?
  errorLog        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TrackingEvent {
  id          String   @id @default(uuid())
  type        String
  url         String?
  profileId   String
  tenantId    String
  campaignId  String?
  timestamp   DateTime @default(now())

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([tenantId])
}

model WebActivity {
  id              String   @id @default(uuid())
  profileId       String?
  fingerprint     String
  url             String
  duration        Int
  scrollDepth     Int
  timestamp       DateTime @default(now())

  profile         Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  urlScoreAwarded Boolean  @default(false)

  @@index([fingerprint])
  @@index([profileId])
}